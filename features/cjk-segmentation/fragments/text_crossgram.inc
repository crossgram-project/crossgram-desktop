// Crossgram: words for the scripts that write without spaces between words.
//
// Chinese and Japanese run their words together, so a text of them has no
// separator to cut at, and only the words of the language tell them apart.
// The separator list of this library and Qt's own cursor movement know
// punctuation alone, so one run of such characters is one word for them: a
// double click selects a whole sentence and Ctrl+Left/Right jumps over one.
// (Qt knows about the problem - see the comment about line breaks that do
// not work with Japanese in its QTextCursor::EndOfLine.)
//
// The missing step is the one that splits such a run into words, which is why
// the mobile clients of the same service behave differently here: their
// platform hands them a dictionary of the language. This file adds that step
// to the client. A run is split by the frequency dictionary in
// text_crossgram_words.inc, generated by
// features/cjk-segmentation/tools/build-dictionary.mjs in the Crossgram
// patcher: every way to cut the run is scored by the frequencies of the words
// it makes, the best one wins, and a character the dictionary does not know
// becomes a word of its own.
//
// Every function below reads a string that starts at a multiple of
// kChunkLength in the coordinates of its caller. Only one such chunk is split
// at a time, which bounds the work for a run of any length and lets a caller
// that owns a window of a text instead of the whole text - the keyboard
// selection of the message history - pass that window.

#include "ui/text/text_crossgram_words.inc"

#include <QtCore/QByteArray>

#include <algorithm>

namespace Ui::Text::WordSegment {
namespace {

// A word of the dictionary is at most this long, in UTF-16 units. The
// generator refuses to put a longer word in.
constexpr auto kMaxWordUnits = 16;

// What a lookup of a word the dictionary does not know answers with.
constexpr auto kNoWord = INT_MIN;

[[nodiscard]] uint32 ReadUint32(const uchar *data) {
	return uint32(data[0])
		| (uint32(data[1]) << 8)
		| (uint32(data[2]) << 16)
		| (uint32(data[3]) << 24);
}

[[nodiscard]] int ReadInt16(const uchar *data) {
	const auto value = uint16(uint16(data[0]) | (uint16(data[1]) << 8));
	return (value >= 0x8000) ? (int(value) - 0x10000) : int(value);
}

// The dictionary the patcher generated: words sorted by their UTF-8 bytes,
// with the offsets and the scores of the words next to them, so that a word
// is found by a binary search and nothing has to be spent on a lookup table.
struct Dictionary {
	QByteArray storage;
	uint32 count = 0;
	uint32 maxUnits = 1;
	int unknownScore = 0;

	[[nodiscard]] const uchar *offsets() const {
		return reinterpret_cast<const uchar*>(storage.constData()) + 16;
	}
	[[nodiscard]] const uchar *scores() const {
		return offsets() + (count + 1) * 4;
	}
	[[nodiscard]] const uchar *words() const {
		return scores() + count * 2;
	}

	[[nodiscard]] int find(const uchar *word, int length) const {
		auto from = uint32(0);
		auto till = count;
		while (from < till) {
			const auto middle = from + (till - from) / 2;
			const auto offset = ReadUint32(offsets() + middle * 4);
			const auto size = int(ReadUint32(offsets() + middle * 4 + 4) - offset);
			const auto entry = words() + offset;
			const auto common = (size < length) ? size : length;
			auto compare = 0;
			for (auto index = 0; index != common; ++index) {
				if (entry[index] != word[index]) {
					compare = (entry[index] < word[index]) ? -1 : 1;
					break;
				}
			}
			if (!compare) {
				compare = (size < length) ? -1 : (size > length) ? 1 : 0;
			}
			if (!compare) {
				return ReadInt16(scores() + middle * 2);
			} else if (compare < 0) {
				from = middle + 1;
			} else {
				till = middle;
			}
		}
		return kNoWord;
	}
};

// Unpacks the list, once. A list that does not read as one leaves the
// dictionary empty, and every character becomes a word of its own then,
// which is what a client without a dictionary has to do.
[[nodiscard]] Dictionary ReadDictionary() {
	auto result = Dictionary();
	result.storage = CrossgramWordsPayload();
	const auto size = int(result.storage.size());
	if (size < 16) {
		return result;
	}
	const auto data = reinterpret_cast<const uchar*>(result.storage.constData());
	const auto count = ReadUint32(data + 4);
	const auto offsets = (count + 1) * 4;
	const auto scores = count * 2;
	const auto wordsAt = 16 + offsets + scores;
	if (ReadUint32(data) != kCrossgramWordsVersion
		|| !count
		|| (count > 1000000)
		|| (size < int(wordsAt))
		|| (ReadUint32(data + 12 + offsets) != uint32(size - int(wordsAt)))) {
		return result;
	}
	result.count = count;
	result.maxUnits = ReadUint32(data + 8);
	result.unknownScore = ReadInt16(data + 12);
	return result;
}

[[nodiscard]] const Dictionary &WordDictionary() {
	static const auto result = ReadDictionary();
	return result;
}

// Whether the character belongs to a script that writes its words together
// and needs a dictionary to tell them apart. Hangul and the scripts read from
// the right are not here: they separate words with spaces, and the second
// kind Qt moves visually, where this patch keeps out of the way.
[[nodiscard]] bool IsSegmentable(QChar ch) {
	const auto code = int(ch.unicode());
	return (code >= 0x3005 && code <= 0x3007)   // 々, 〆, 〇
		|| (code >= 0x3040 && code <= 0x30FF)   // hiragana and katakana
		|| (code >= 0x31F0 && code <= 0x31FF)   // katakana phonetic extensions
		|| (code >= 0x3100 && code <= 0x312F)   // bopomofo
		|| (code >= 0x3400 && code <= 0x4DBF)   // unified ideographs, extension A
		|| (code >= 0x4E00 && code <= 0x9FFF)   // unified ideographs
		|| (code >= 0xF900 && code <= 0xFAFF);  // compatibility ideographs
}

// Punctuation of those scripts, which the separator list of this library,
// written for texts of spaces, does not know about.
[[nodiscard]] bool IsSegmentableSeparator(QChar ch) {
	const auto code = int(ch.unicode());
	return (code >= 0x3000 && code <= 0x3003)   // ideographic space, 、。〃
		|| (code >= 0x3008 && code <= 0x3011)   // 〈〉《》「」『』【】
		|| (code >= 0x3014 && code <= 0x301F)   // 〔〕〖〗〘〙〚〛〜〝〞〟
		|| (code == 0x3030)                     // 〰
		|| (code == 0x303D)                     // 〽
		|| (code == 0x30A0)                     // ゠
		|| (code == 0x30FB)                     // ・
		|| (code >= 0xFE10 && code <= 0xFE19)   // vertical forms
		|| (code >= 0xFE30 && code <= 0xFE4F)   // compatibility forms
		|| (code >= 0xFE50 && code <= 0xFE6B)   // small variants
		|| (code >= 0xFF01 && code <= 0xFF0F)   // ！＂＃＄％＆＇（）＊＋，－．／
		|| (code >= 0xFF1A && code <= 0xFF20)   // ：；＜＝＞？＠
		|| (code >= 0xFF3B && code <= 0xFF40)   // ［＼］＾＿｀
		|| (code >= 0xFF5B && code <= 0xFF65)   // ｛｜｝～｟｠｡｢｣､･
		|| (code >= 0xFFE0 && code <= 0xFFE5);  // ￠￡￢￣￤￥
}

// Whether the character splits words on its own, with an apostrophe that
// stands inside a word belonging to that word, the way the newest upstream
// reads it.
[[nodiscard]] bool IsSeparatorAt(const QString &text, int position) {
	if (position < 0 || position >= int(text.size())) {
		return true;
	}
	const auto ch = text.at(position);
	const auto unicode = int(ch.unicode());
	const auto apostrophe = (unicode == '\'')
		|| (unicode == 0x2018)
		|| (unicode == 0x2019);
	if (!apostrophe) {
		return IsWordSeparator(ch) || IsSegmentableSeparator(ch);
	}
	const auto edge = [&](int index) {
		return (index < 0)
			|| (index >= int(text.size()))
			|| IsWordSeparator(text.at(index))
			|| IsSegmentableSeparator(text.at(index));
	};
	return edge(position - 1) || edge(position + 1);
}

// Writes text[from, from + length) as UTF-8 into 'buffer' and returns the
// number of bytes written. The dictionary is sorted by these bytes.
[[nodiscard]] int EncodeWord(const QString &text, int from, int length, uchar *buffer) {
	auto bytes = 0;
	for (auto index = 0; index != length; ++index) {
		auto code = uint32(text.at(from + index).unicode());
		if (code >= 0xD800 && code <= 0xDBFF && index + 1 != length) {
			const auto next = uint32(text.at(from + index + 1).unicode());
			if (next >= 0xDC00 && next <= 0xDFFF) {
				code = 0x10000 + ((code - 0xD800) << 10) + (next - 0xDC00);
				++index;
			}
		}
		if (code < 0x80) {
			buffer[bytes++] = uchar(code);
		} else if (code < 0x800) {
			buffer[bytes++] = uchar(0xC0 | (code >> 6));
			buffer[bytes++] = uchar(0x80 | (code & 0x3F));
		} else if (code < 0x10000) {
			buffer[bytes++] = uchar(0xE0 | (code >> 12));
			buffer[bytes++] = uchar(0x80 | ((code >> 6) & 0x3F));
			buffer[bytes++] = uchar(0x80 | (code & 0x3F));
		} else {
			buffer[bytes++] = uchar(0xF0 | (code >> 18));
			buffer[bytes++] = uchar(0x80 | ((code >> 12) & 0x3F));
			buffer[bytes++] = uchar(0x80 | ((code >> 6) & 0x3F));
			buffer[bytes++] = uchar(0x80 | (code & 0x3F));
		}
	}
	return bytes;
}

[[nodiscard]] int LookupWord(const QString &text, int from, int length) {
	uchar buffer[kMaxWordUnits * 3];
	return WordDictionary().find(buffer, EncodeWord(text, from, length, buffer));
}

// The word of the dictionary that contains 'position', inside the run of
// segmentable characters [from, to) that the caller clipped to one chunk.
[[nodiscard]] TextSelection SplitChunk(const QString &text, int from, int to, int position) {
	const auto size = to - from;
	const auto limit = std::min(int(WordDictionary().maxUnits), kMaxWordUnits);
	int32 scores[kChunkLength + 1];
	uchar lengths[kChunkLength + 1];
	scores[size] = 0;
	lengths[size] = 0;
	for (auto index = size; index != 0;) {
		--index;
		const auto single = LookupWord(text, from + index, 1);
		const auto unknown = (single != kNoWord)
			? single
			: WordDictionary().unknownScore;
		auto best = unknown + scores[index + 1];
		auto bestLength = uchar(1);
		for (auto length = 2; length <= limit && index + length <= size; ++length) {
			const auto score = LookupWord(text, from + index, length);
			if (score == kNoWord) {
				continue;
			}
			if (const auto total = score + scores[index + length]; total > best) {
				best = total;
				bestLength = uchar(length);
			}
		}
		scores[index] = best;
		lengths[index] = bestLength;
	}
	const auto at = position - from;
	auto start = 0;
	while (start + lengths[start] <= at) {
		start += lengths[start];
	}
	return { uint16(from + start), uint16(from + start + lengths[start]) };
}

// The word that contains 'position'. A character of a script above is looked
// up in the dictionary, and every other character is a word together with
// the run of characters around it that the separator list does not split.
[[nodiscard]] TextSelection WordAt(const QString &text, int position) {
	if (IsSegmentable(text.at(position))) {
		const auto chunk = (position / kChunkLength) * kChunkLength;
		auto from = chunk;
		auto to = std::min(chunk + kChunkLength, int(text.size()));
		while (from < position && !IsSegmentable(text.at(from))) {
			++from;
		}
		while (to > position + 1 && !IsSegmentable(text.at(to - 1))) {
			--to;
		}
		return SplitChunk(text, from, to, position);
	}
	auto from = position;
	while (from > 0
		&& !IsSeparatorAt(text, from - 1)
		&& !IsSegmentable(text.at(from - 1))) {
		--from;
	}
	auto to = position + 1;
	while (to < int(text.size())
		&& !IsSeparatorAt(text, to)
		&& !IsSegmentable(text.at(to))) {
		++to;
	}
	return { uint16(from), uint16(to) };
}

} // namespace

// Whether the character at 'position' separates words.
[[nodiscard]] bool IsSeparator(const QString &text, int position) {
	return IsSeparatorAt(text, position);
}

// The first position of the word that contains 'position', which is
// 'position' itself when it separates words.
[[nodiscard]] int Start(const QString &text, int position) {
	if (position <= 0) {
		return 0;
	} else if (position >= int(text.size())) {
		return int(text.size());
	} else if (IsSeparatorAt(text, position)) {
		return position;
	}
	return int(WordAt(text, position).from);
}

// The position of the first character after the word that contains
// 'position', which is the position after it when it separates words.
[[nodiscard]] int End(const QString &text, int position) {
	if (position < 0) {
		return 0;
	} else if (position >= int(text.size())) {
		return int(text.size());
	} else if (IsSeparatorAt(text, position)) {
		return position + 1;
	}
	return int(WordAt(text, position).to);
}

// The position the cursor moves to, when it moves one word forward: over the
// separators it stands on, to the end of the word behind them. The message
// history moves this way, and it never skips the separators after the word.
[[nodiscard]] int MoveForward(const QString &text, int position) {
	const auto size = int(text.size());
	auto result = position;
	while (result < size && IsSeparatorAt(text, result)) {
		++result;
	}
	return (result < size) ? End(text, result) : result;
}

// The position the cursor moves to, when it moves one word back: over the
// separators before it, to the start of the word behind them.
[[nodiscard]] int MoveBackward(const QString &text, int position) {
	auto result = (position > 0) ? (position - 1) : 0;
	while (result > 0 && IsSeparatorAt(text, result)) {
		--result;
	}
	return (result > 0) ? Start(text, result) : result;
}

// Whether the text carries characters that are read from the right, in which
// case Qt moves the cursor over it visually.
[[nodiscard]] bool IsRightToLeft(const QString &text) {
	for (const auto &ch : text) {
		const auto direction = ch.direction();
		if (direction == QChar::DirR || direction == QChar::DirAL) {
			return true;
		}
	}
	return false;
}

} // namespace Ui::Text::WordSegment
